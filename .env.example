# Required: Google AI Studio / Gemini Developer API key
GEMINI_API_KEY=

# Optional server secret for HMAC offer tokens & AES-256-GCM checkout tokens
# (Defaults to a deterministic key derived from GEMINI_API_KEY if omitted)
APP_SECRET=

# Optional runtime model overrides
GEMINI_VIDEO_MODEL=gemini-4-neon
GEMINI_DECISIONS_MODEL=gemini-decision-1

# Optional app origin & commerce locale defaults
APP_ORIGIN=http://localhost:3000
SHOP_COUNTRY=US
SHOP_CURRENCY=USD
